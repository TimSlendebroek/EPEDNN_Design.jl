    given-names: Tim
    email: tim@slendebroek.com
version: "1.1.0"
date-released: "2026-06-04"
license: Apache-2.0
url: "https://iter.fuseexplorer.com/EPED"
repository-code: "https://github.com/TimSlendebroek/EPEDNN_Design.jl"
keywords:
  - tokamak
  - pedestal
  - EPED
  - neural network
  - deep ensemble
  - uncertainty quantification
